.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background-color: #f5efe6;
  background-size: cover;
  background-position: center;
}

.mask {
  position: absolute;
  inset: 0;
  background: rgba(255, 250, 242, 0.38);
}

.content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 48rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.title {
  margin-bottom: 44rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  color: #3f372f;
  font-weight: 500;
}

.card {
  width: 100%;
  box-sizing: border-box;
  padding: 64rpx 52rpx 56rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 24rpx 70rpx rgba(65, 46, 28, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(18px);
}

.card.solid {
  background: rgba(255, 252, 246, 0.94);
  box-shadow: 0 20rpx 60rpx rgba(92, 72, 46, 0.10);
}

.quote-mark {
  height: 40rpx;
  font-family: Georgia, serif;
  font-size: 92rpx;
  line-height: 40rpx;
  color: rgba(126, 92, 52, 0.24);
}

.quote {
  margin-top: 28rpx;
  font-size: 42rpx;
  line-height: 1.72;
  letter-spacing: 2rpx;
  color: #302a24;
  font-weight: 500;
  white-space: pre-line;
}

.source {
  margin-top: 34rpx;
  text-align: right;
  font-size: 26rpx;
  color: rgba(48, 42, 36, 0.68);
}

.divider {
  margin: 46rpx 0 36rpx;
  height: 1rpx;
  background: rgba(58, 48, 38, 0.14);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.action-line {
  font-size: 30rpx;
  line-height: 1.5;
  color: #3a3128;
  letter-spacing: 2rpx;
}

.checkins {
  margin-top: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
}

.checkin {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 10rpx;
}

.dot {
  font-size: 34rpx;
  color: rgba(48, 42, 36, 0.48);
}

.dot.on {
  color: #3a3128;
}

.checkin-text {
  font-size: 30rpx;
  color: #3a3128;
}
